# 当前生效配置（一次只启用一组；默认主力：DeepSeek V4 Pro）
AI_API_KEY=your_api_key_here
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
AI_PROVIDER=openai
AI_MAX_TOKENS=16384
AI_THINKING=disabled
SERVER_PORT=3001

# 若方舟 OpenAI 兼容接口不接受 response_format，可设为 off
# AI_RESPONSE_FORMAT=off

# ========== 备选切换（见 model-candidates.json）==========

# --- DeepSeek V4 Pro（OpenAI 兼容，当前主力）---
# Key 获取：https://platform.deepseek.com/api_keys
# AI_API_KEY=your_deepseek_key
# AI_API_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-pro
# AI_PROVIDER=openai
# AI_MAX_TOKENS=16384
# AI_THINKING=disabled

# --- DeepSeek V4 Flash（降本备选）---
# AI_MODEL=deepseek-v4-flash
# AI_THINKING=disabled

# --- 智谱 GLM-5.2（Anthropic 兼容，质量基线 / 难例兜底）---
# AI_API_KEY=your_zhipu_key
# AI_API_BASE_URL=https://open.bigmodel.cn/api/anthropic
# AI_MODEL=glm-5.2
# AI_PROVIDER=anthropic-compatible

# --- 火山方舟 · 豆包（OpenAI 兼容）---
# 普通推理：/api/v3 + 已开通的模型 ID
# Agent Plan：专属 Key + /api/plan/v3（模型需支持 Agent Plan）
# AI_API_KEY=your_ark_api_key
# AI_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_MODEL=doubao-seed-2-1-turbo-260628
# AI_PROVIDER=openai
# AI_MODEL=doubao-seed-2-1-pro-260628
